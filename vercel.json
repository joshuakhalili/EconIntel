{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "framework": null,
  "regions": [
    "lhr1"
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/waitlist",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/thanks",
      "destination": "/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/healthz",
      "destination": "/api/index"
    },
    {
      "source": "/overview",
      "destination": "/app"
    },
    {
      "source": "/login",
      "destination": "/app"
    },
    {
      "source": "/lens/:slug",
      "destination": "/app"
    },
    {
      "source": "/q/:slug",
      "destination": "/app"
    },
    {
      "source": "/explore",
      "destination": "/app"
    },
    {
      "source": "/data",
      "destination": "/app"
    },
    {
      "source": "/data/:id",
      "destination": "/app"
    },
    {
      "source": "/news",
      "destination": "/app"
    },
    {
      "source": "/pipeline",
      "destination": "/app"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-0TMJt/dENKI8PsDY9Ese9cXlRIwtvIzB0u/2QKTp2+M=' 'sha256-8WI9xq5+bHm6biJTg8NJNnEW6B8NihChU2jZSm33DIA=' 'sha256-YQuCuzBJ24i4gBhpKqck6Fz+jY3jWr4YQy3ixSMVy1E=' 'sha256-mOpC6Xv0JqVyqTcxYyuYyhI5cBB7TJe93xCtDuL6/fo=' 'sha256-mxGLvoz2gWXnu6wUgCfErK9GUDaFpmS1VC2StwtQorc=' 'sha256-qOi5T08WW1Htc5YADz4C7xQhGtVYMbLaccGi9smu3Lw=' 'sha256-t2vIQ++0Uc6+d8MX8VTj91tBlwy6Hf6ubyQNl4fgpgE='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://avatars.githubusercontent.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
