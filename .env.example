# ─────────────────────────────────────────────────────────────────────────────
# EconIntel — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ── Database ────────────────────────────────────────────────────────────────
# Local Postgres. Create with:
#   createuser econintel --pwprompt
#   createdb   econintel --owner econintel
DATABASE_URL=postgres://econintel:econintel_dev@localhost:5432/econintel
DB_POOL_MAX=10
SLOW_QUERY_MS=500

# ── Data source credentials ─────────────────────────────────────────────────

# FRED (Federal Reserve Economic Data) — REQUIRED for the productivity pillar.
# Free, instant: https://fredaccount.stlouisfed.org/apikeys
# Rate limit: 120 requests/minute.
FRED_API_KEY=

# SEC EDGAR — no key, but the SEC REQUIRES a User-Agent identifying you and
# blocks requests without one. Format: "Your Name your@email.com"
# Policy: https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=

# Census BTOS (Business Trends and Outlook Survey) — AI adoption rates.
# The adapter throws without this; it is not optional for that pillar.
# Free, instant: https://api.census.gov/data/key_signup.html
# The key arrives by email and must be ACTIVATED via the link before it works.
CENSUS_API_KEY=

# Copernicus Data Space — 10m Sentinel-2 satellite imagery (phase 3).
# Free account: https://dataspace.copernicus.eu
COPERNICUS_TOKEN=

# No key needed for: World Bank, DBnomics, NASA GIBS, Federal Register, RSS.
#
# EMBER_API_KEY / EIA_API_KEY are read by config.js but no adapter consumes
# them yet — setting them does nothing today. BLS needs no key of its own;
# its series arrive through the DBnomics mirror.

# ── LLM layer ───────────────────────────────────────────────────────────────
# The model is handed numbers that SQL has already computed and claims already
# stored, and asked only to connect them. It never produces a figure or a
# citation of its own — see the `narrations.input_hash` column.
#
# Cloudflare Workers AI is the default and the only one needed. Free tier is
# 10,000 neurons/day with no card:
#   1. sign up at dash.cloudflare.com/sign-up
#   2. the account id is the 32-char string in your dashboard URL
#   3. Profile → API Tokens → Create Token → "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Optional paid fallbacks. Nothing requires them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Development flags ───────────────────────────────────────────────────────
# Read recorded fixtures instead of making live HTTP calls. Required in
# environments with restricted outbound network access.
USE_FIXTURES=false
