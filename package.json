{
  "name": "diffusion",
  "version": "1.0.0",
  "description": "Measuring AI's effect on the economy — investment cycles, labour markets, productivity, prices and policy, from sourced data with the limits stated",
  "type": "module",
  "main": "src/server/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "build": "npm run check:tokens && npm run check:contrast && npm run check:routes && vite build && npm run check:vercel",
    "build:vercel": "npm run build && node scripts/build-static.js",
    "check:tokens": "node scripts/check-tokens.js",
    "check:contrast": "node scripts/check-contrast.js",
    "check:routes": "node scripts/check-routes.js",
    "check:vercel": "node scripts/vercel-config.js --check",
    "check:data": "node scripts/check-data.js",
    "vercel:config": "node scripts/vercel-config.js --write",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch src/server/index.js",
    "dev:web": "vite",
    "db:migrate": "node src/server/db/migrate.js",
    "db:status": "node src/server/db/migrate.js status",
    "db:seed": "node src/server/db/seed.js",
    "db:reset": "node src/server/db/migrate.js && node src/server/db/seed.js",
    "ingest": "node src/server/ingestion/runner.js",
    "ingest:force": "node src/server/ingestion/runner.js --force",
    "verify:sources": "node scripts/verify-sources.js",
    "test": "node --test \"src/**/*.test.js\""
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@neondatabase/serverless": "^1.1.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.6",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^6.1.0",
    "cheerio": "^1.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "motion": "^12.43.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "undici": "^8.10.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
