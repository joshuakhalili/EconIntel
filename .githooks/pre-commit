#!/bin/sh
# Block secrets before they leave this machine.
#
# GitHub's push protection is the last line of defence and only fires once the
# commit already exists. This is the first line: it refuses the commit itself,
# so the secret never enters history at all. That distinction matters — a key
# that reaches a commit is compromised even if the commit is never pushed,
# because rewriting history is far harder than not writing it.
#
# Enable with: git config core.hooksPath .githooks

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0

# 1. Any .env variant other than the template must never be staged.
for file in $staged; do
  case "$file" in
    .env.example) ;;
    .env|.env.*)
      echo "BLOCKED: $file is an environment file and must not be committed."
      fail=1
      ;;
    *.pem|*.key|*.p12)
      echo "BLOCKED: $file looks like a private key or certificate."
      fail=1
      ;;
  esac
done

# 2. Scan staged content for key-shaped strings. Assignments only — a bare hex
#    string is usually a git SHA or a checksum, so matching those would cry wolf
#    constantly and train you to use --no-verify, which defeats the whole hook.
#
#    The first rule is written by SHAPE — anything named *KEY, *TOKEN, *SECRET,
#    *PASSWORD assigned a long literal — rather than by listing providers. The
#    provider list this replaced had already gone stale twice: it named
#    COPERNICUS_API_KEY when the real variable is COPERNICUS_TOKEN, and it knew
#    nothing about Cloudflare, so a live Workers AI token passed straight
#    through it. A list of remembered names protects only against the keys you
#    remembered, which is backwards for a safety net.
#
#    Matching is case-insensitive. The old rule spelled the generic words in
#    lowercase, so every SCREAMING_CASE variable — which is to say every line
#    in a real .env file — was invisible to it.
#
#    THE BARE-WORD PROBLEM, and why the name rule requires a prefix.
#
#    The name side used to be `[A-Za-z0-9_]*(KEY|...)` — a STAR, so it matched
#    the bare word `key` with nothing in front of it. That is not a credential
#    name, it is one of the most common object properties in existence, and it
#    blocked a perfectly ordinary config file: Vercel's headers schema is a
#    list of `{ key: "Content-Security-Policy", value: ... }`, and every header
#    name is a long enough run of letters and hyphens to satisfy the value
#    side. Nothing secret was anywhere near it.
#
#    That matters more than the nuisance suggests. A hook that blocks a file
#    with no secret in it teaches exactly one lesson — reach for --no-verify —
#    and a hook that gets bypassed by reflex protects nothing at all. The
#    comment above already says this about bare hex strings; it applies with
#    equal force here.
#
#    So a bare keyword now needs corroboration from the VALUE. Two rules:
#      1. a real variable name — at least one identifier character before the
#         keyword, which is what `API_KEY`, `sessionSecret`, `FRED_API_KEY` and
#         `GITHUB_CLIENT_SECRET` all have and `key:` does not — any value.
#      2. a bare keyword, but only when the value contains a digit somewhere
#         inside it. Real credentials are high-entropy and effectively always
#         carry digits; header names, CSS properties and English words do not.
#
#    The known gap in rule 2, stated rather than left to be discovered: a bare
#    `secret = 'somepassphrasewithnodigits'` is not caught. Rule 1 catches it
#    the moment the variable has a real name, and every provider shape below is
#    caught regardless. Widening rule 2 to digitless values puts every English
#    sentence in a string back in scope, which is the bare-word problem again.
#
#    `sk-` covers OpenAI's older keys AND the newer `sk-proj-` / `sk-ant-`
#    project keys, which the previous `sk-[A-Za-z0-9]{20,}` did NOT: it stops
#    at the first hyphen, so `sk-proj-…` only ever offered it four characters
#    and a live key would have committed cleanly. Verified against both shapes.
#
#    It is anchored to a token boundary, and that is not cosmetic: allowing
#    hyphens inside the run means an unanchored `sk-` matches in the MIDDLE of
#    ordinary words — `task-oriented-design-system` contains `sk-oriented-…`,
#    twenty-odd legal characters, and blocked a commit in testing. `risk-`,
#    `desk-` and `disk-` do the same.
patterns='[A-Za-z0-9_]+(KEY|TOKEN|SECRET|PASSWD|PASSWORD)["'"'"' ]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_-]{16,}
(KEY|TOKEN|SECRET|PASSWD|PASSWORD)["'"'"' ]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_-]{6,}[0-9][A-Za-z0-9_-]{6,}
(^|[^A-Za-z0-9_-])sk-[A-Za-z0-9_-]{20,}
ghp_[A-Za-z0-9]{36}
AKIA[0-9A-Z]{16}
cfut_[A-Za-z0-9]{20,}
postgres(ql)?://[^:/]+:[^@]{8,}@[A-Za-z0-9-]+\.'

for file in $staged; do
  [ -f "$file" ] || continue
  case "$file" in .env.example|.githooks/*) continue ;; esac

  echo "$patterns" | while IFS= read -r pattern; do
    [ -z "$pattern" ] && continue
    if git show ":$file" 2>/dev/null | grep -niEq "$pattern"; then
      echo "BLOCKED: $file contains something shaped like a live credential:"
      git show ":$file" 2>/dev/null | grep -niE "$pattern" | head -3 | sed 's/^/    /'
      exit 1
    fi
  done || fail=1
done

if [ "$fail" -ne 0 ]; then
  cat <<'MSG'

Commit refused. Move the value into .env (which is gitignored) and read it
through src/server/config.js instead of writing it inline.

If this is a false positive, re-run with:  git commit --no-verify

If a real key has ALREADY been pushed anywhere public, do not try to delete
the commit — bots scrape new commits within seconds. Revoke and regenerate
the key at the provider instead.
MSG
  exit 1
fi

exit 0
