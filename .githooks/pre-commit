#!/bin/bash
# Block secrets before they leave this machine.
#
# GitHub's push protection is the last line of defence and only fires once the
# commit already exists. This is the first line: it refuses the commit itself,
# so the secret never enters history at all. That distinction matters — a key
# that reaches a commit is compromised even if the commit is never pushed,
# because rewriting history is far harder than not writing it.
#
# Enable with: git config core.hooksPath .githooks
#
# WHY BASH AND NOT /bin/sh
#
# A staged filename containing a space was silently skipped. The file list came
# back newline-separated and was iterated with `for file in $staged`, which
# word-splits on ALL whitespace — so `docs/my notes.md` became two entries,
# neither of which exists, and both the filename rule and the content scan
# passed over the real file without reading it. A file this hook cannot read is
# a file it cannot refuse.
#
# The fix is a NUL-delimited list, and `read -d ''` is not POSIX. Process
# substitution below is not either, and it is what keeps `fail` in this shell
# rather than in a pipeline's subshell where its value would be discarded. Both
# want bash, which every machine this runs on has.

fail=0

# 1. Any .env variant other than the template must never be staged.
#
# `*.env` AND `.env*`, because the rule used to be anchored at the START of the
# name: `prod.env`, `staging.env` and `src/config/.env` all slipped through a
# check written for `.env.local`. `.gitignore` covers the same two shapes for
# the same reason.
while IFS= read -r -d '' file; do
  case "$file" in
    .env.example|*.env.example) ;;
    .env|.env.*|*.env|*.env.*)
      echo "BLOCKED: $file is an environment file and must not be committed."
      fail=1
      ;;
    *.pem|*.key|*.p12)
      echo "BLOCKED: $file looks like a private key or certificate."
      fail=1
      ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACM)

# 2. Scan staged content for key-shaped strings. Assignments only — a bare hex
#    string is usually a git SHA or a checksum, so matching those would cry wolf
#    constantly and train you to use --no-verify, which defeats the whole hook.
#
#    The first rule is written by SHAPE — anything named *KEY, *TOKEN, *SECRET,
#    *PASSWORD assigned a long literal — rather than by listing providers. The
#    provider list this replaced had already gone stale twice: it named
#    COPERNICUS_API_KEY when the real variable is COPERNICUS_TOKEN, and it knew
#    nothing about Cloudflare, so a live Workers AI token passed straight
#    through it. A list of remembered names protects only against the keys you
#    remembered, which is backwards for a safety net.
#
#    Matching is case-insensitive. The old rule spelled the generic words in
#    lowercase, so every SCREAMING_CASE variable — which is to say every line
#    in a real .env file — was invisible to it.
#
#    THE BARE-WORD PROBLEM, and why the name rule requires a prefix.
#
#    The name side used to be `[A-Za-z0-9_]*(KEY|...)` — a STAR, so it matched
#    the bare word `key` with nothing in front of it. That is not a credential
#    name, it is one of the most common object properties in existence, and it
#    blocked a perfectly ordinary config file: Vercel's headers schema is a
#    list of `{ key: "Content-Security-Policy", value: ... }`, and every header
#    name is a long enough run of letters and hyphens to satisfy the value
#    side. Nothing secret was anywhere near it.
#
#    That matters more than the nuisance suggests. A hook that blocks a file
#    with no secret in it teaches exactly one lesson — reach for --no-verify —
#    and a hook that gets bypassed by reflex protects nothing at all. The
#    comment above already says this about bare hex strings; it applies with
#    equal force here.
#
#    So a bare keyword now needs corroboration from the VALUE. Two rules:
#      1. a real variable name — at least one identifier character before the
#         keyword, which is what `API_KEY`, `sessionSecret`, `FRED_API_KEY` and
#         `GITHUB_CLIENT_SECRET` all have and `key:` does not — any value.
#      2. a bare keyword, but only when the value contains a digit somewhere
#         inside it. Real credentials are high-entropy and effectively always
#         carry digits; header names, CSS properties and English words do not.
#
#    UNDERSCORES ARE NOT ALLOWED IN A VALUE, and that is the second false
#    positive this hook has produced. Rule 1 matched
#
#      baselineKey: 'unemployment_pct'
#      modelKey:    'investment_shock_v1'
#
#    in an ordinary simulation module. `<something>Key: '<snake_case>'` is one
#    of the most common shapes in JavaScript, and rule 1's value side accepted
#    any 16 characters.
#
#    The discriminator is entropy. A real credential is random — hex, base64,
#    a provider prefix and a blob — and does not contain underscores dividing
#    short English words. So the value side now excludes `_` entirely, which
#    admits every real key shape below and rejects snake_case identifiers.
#
#    The cost, stated: a secret that genuinely contains an underscore is missed
#    by rules 1 and 2. That is a narrow gap — every provider pattern below
#    still catches its own shape regardless, and .env files are refused
#    outright by the file check above, which is where such a value would
#    actually live.
#
#    The known gap in rule 2, stated rather than left to be discovered: a bare
#    `secret = 'somepassphrasewithnodigits'` is not caught. Rule 1 catches it
#    the moment the variable has a real name, and every provider shape below is
#    caught regardless. Widening rule 2 to digitless values puts every English
#    sentence in a string back in scope, which is the bare-word problem again.
#
#    `sk-` covers OpenAI's older keys AND the newer `sk-proj-` / `sk-ant-`
#    project keys, which the previous `sk-[A-Za-z0-9]{20,}` did NOT: it stops
#    at the first hyphen, so `sk-proj-…` only ever offered it four characters
#    and a live key would have committed cleanly. Verified against both shapes.
#
#    It is anchored to a token boundary, and that is not cosmetic: allowing
#    hyphens inside the run means an unanchored `sk-` matches in the MIDDLE of
#    ordinary words — `task-oriented-design-system` contains `sk-oriented-…`,
#    twenty-odd legal characters, and blocked a commit in testing. `risk-`,
#    `desk-` and `disk-` do the same.
#
#    THE PROVIDER SHAPES BELOW THE TWO GENERIC RULES, and why each is here.
#
#    Every one of these was MISSED by the rules above it, verified by running
#    the pattern set over a bank of realistic credentials:
#
#      xoxb-…    Slack bot token. Hyphen-separated, so the generic value rule
#                (which stops at the first non-[A-Za-z0-9-] character) sees it
#                but the NAME side did not fire: `SLACK_BOT=` ends in neither
#                KEY, TOKEN, SECRET nor PASSWORD.
#      AIzaSy…   Google API key. Same reason. Google's keys are a fixed 39
#                characters beginning `AIzaSy`, which is about as unambiguous
#                as a credential shape gets.
#      glpat-…   GitLab personal access token.
#      npg_…     A BARE NEON PASSWORD, and the one that matters most here: this
#                project's database password lives inside a Neon connection
#                string, and the moment somebody copies just the password out
#                of one — into a note, a script, a `DB_PASSWORD=` line — the
#                connection-string rule no longer applies. It was missed by
#                the generic rules because their value side excludes `_`
#                (deliberately: see the entropy argument above) and `npg` is
#                only three characters before the underscore.
#      eyJ….eyJ… A JWT: base64 for `{"` twice, separated by a dot. This is how
#                a Supabase service-role key or a signed session travels, and
#                `SUPABASE_SERVICE_ROLE=` matches no keyword rule.
#
#    All five are anchored to a fixed provider prefix, so none of them can fire
#    on ordinary prose the way a bare keyword can. Verified: the full set below
#    produces ZERO matches across every committable file in the repository.
patterns=(
  '[A-Za-z0-9_]+(KEY|TOKEN|SECRET|PASSWD|PASSWORD)["'"'"' ]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9-]{16,}'
  '(KEY|TOKEN|SECRET|PASSWD|PASSWORD)["'"'"' ]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9-]{6,}[0-9][A-Za-z0-9-]{6,}'
  '(^|[^A-Za-z0-9_-])sk-[A-Za-z0-9_-]{20,}'
  'ghp_[A-Za-z0-9]{36}'
  'AKIA[0-9A-Z]{16}'
  'cfut_[A-Za-z0-9]{20,}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  'AIzaSy[A-Za-z0-9_-]{27,}'
  'glpat-[A-Za-z0-9_-]{20,}'
  'npg_[A-Za-z0-9]{12,}'
  'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.'
  'postgres(ql)?://[^:/]+:[^@]{8,}@[A-Za-z0-9-]+\.'
)

# A temp file rather than a shell variable, because the staged content may be
# binary: command substitution silently drops NUL bytes and prints a warning
# per file. It also means one `git show` per file instead of one per pattern.
staged_content=$(mktemp "${TMPDIR:-/tmp}/precommit-scan.XXXXXX") || exit 1
trap 'rm -f "$staged_content"' EXIT

while IFS= read -r -d '' file; do
  case "$file" in .env.example|*.env.example|.githooks/*) continue ;; esac

  # Read from the INDEX, not the worktree. What is being committed is the
  # staged content, which is not necessarily what is on disk — and a file
  # staged then deleted from the worktree still enters history.
  git show ":$file" > "$staged_content" 2>/dev/null || continue

  for pattern in "${patterns[@]}"; do
    if grep -niEq -- "$pattern" "$staged_content"; then
      echo "BLOCKED: $file contains something shaped like a live credential:"
      grep -niE -- "$pattern" "$staged_content" | head -3 | sed 's/^/    /'
      fail=1
      break
    fi
  done
done < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ "$fail" -ne 0 ]; then
  cat <<'MSG'

Commit refused. Move the value into .env (which is gitignored) and read it
through src/server/config.js instead of writing it inline.

If this is a false positive, re-run with:  git commit --no-verify

If a real key has ALREADY been pushed anywhere public, do not try to delete
the commit — bots scrape new commits within seconds. Revoke and regenerate
the key at the provider instead.
MSG
  exit 1
fi

exit 0
