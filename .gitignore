node_modules/
dist/
build/
*.log
.DS_Store
coverage/

# public/ is build output, not source, since the front end moved to
# src/client/ and Vite writes here. Express still serves this directory —
# it just no longer contains anything hand-written.
public/

# Secrets. `.env.example` is the committed template and is re-included below;
# every other .env variant is ignored by default so a new one (.env.production,
# .env.staging) is safe the moment it is created rather than when remembered.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json

# Row dumps written by the one-off repair scripts before they delete anything.
# They are a safety net for the machine that ran the repair, not source, and
# they hold observation data that belongs in the database.
.backup-*.json

# The landing page's mirror tooling and caches. landing/ itself IS source and
# is committed; these are the working files of the clone pipeline.
landing/.mirror-cache/
landing/docs/verify-shots/
landing/.content-applied
.vercel
.env*
